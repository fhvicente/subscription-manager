# App Name
NEXT_PUBLIC_APP_NAME="SubTrack"

# App domain
NEXT_PUBLIC_API_URL=https://subtrack.fly.dev/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth configuration
